<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system launch splash: ivory, gold icon → flows straight into the in-app splash -->
    <style name="Theme.Nova" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/nova_bg</item>
        <item name="android:statusBarColor">@color/nova_bg</item>
        <item name="android:navigationBarColor">@color/nova_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/nova_gold</item>
        <item name="android:colorPrimary">@color/nova_gold</item>
        <item name="android:colorControlActivated">@color/nova_gold</item>
        <item name="android:textColorHighlight">#552457D6</item>
        <item name="android:windowSplashScreenBackground">@color/nova_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_fg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/nova_bg</item>
    </style>
</resources>
