# The PRIVATE license-signing key lives OUTSIDE the repository (offline machine / password manager / HSM).
# Use either a file path or an inline PEM; never put the key in this repo.
LICENSE_PRIVATE_KEY_FILE=/secure/location/nova-license-private.pem
# LICENSE_PRIVATE_KEY_PEM=

# Optional: PUBLIC key, lets `verify` also check signatures.
LICENSE_PUBLIC_KEY=
