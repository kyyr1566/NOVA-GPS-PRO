# Copy to .env (git-ignored) or set these in your process manager. NEVER commit real values.

# PUBLIC key of the license issuer (printed by tools/license-generator `keygen`). Not secret.
LICENSE_PUBLIC_KEY=

# PRIVATE key the server uses to sign activation receipts (created with `node cli.js keygen --out-dir <dir outside the repo>`).
# Use either a file path (preferred) or an inline PEM.
ACTIVATION_PRIVATE_KEY_FILE=/etc/nova-license/nova-activation-private.pem
# ACTIVATION_PRIVATE_KEY_PEM=

# Network: bind locally and let a reverse proxy (nginx/Caddy) terminate TLS. The app only talks HTTPS.
HOST=127.0.0.1
PORT=8080
# Set to 1 only when running behind your own reverse proxy (so the rate limiter sees the real client address).
TRUST_PROXY=0
RATE_LIMIT_PER_MINUTE=20

DATABASE_PATH=/var/lib/nova-license/licenses.db
